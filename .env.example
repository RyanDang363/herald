# ASI:One LLM API key (Orchestrator reasoning). Leave blank when USE_MOCK=true.
ASIONE_API_KEY=YOUR_API_KEY_HERE

# Redis connection. Leave blank to use the in-memory store (no Redis needed for local dev).
# Redis Cloud format:  redis://default:<password>@<host>:<port>
REDIS_URL=

# Redis Iris Agent Memory (Orchestrator long-term recall).
# Leave all three blank to use NoopMemory (agents still run; no semantic recall).
AGENT_MEMORY_BASE_URL=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=

# Base seed for deterministic agent address derivation.
AGENT_SEED=er-twin-demo-seed

# When true, the Orchestrator returns hardcoded responses instead of calling ASI:One.
# Also forces InMemoryStore and NoopMemory so the demo runs with zero external dependencies.
USE_MOCK=true

# Path to the master EHR fixture. Default works from the repo root.
EHR_MASTER_PATH=fixtures/ehr_master.json

# --- Dashboard ---
# Data source:
#   "live"    — shared in-process store (default when Bureau + dashboard co-hosted in main.py)
#   "redis"   — multi-process mode; agents and dashboard share the same Redis instance
#   "fixture" — offline/screenshot mode, static JSON fixture (standalone dashboard only)
DASHBOARD_SOURCE=live
# The dashboard command bar is disabled. Send commands through Orchestrator chat (ASI:One or USE_MOCK).
DASHBOARD_ALLOW_INPUT=false
DASHBOARD_PORT=8050
# Login gate (demo only — NOT real HIPAA). Change these for anything beyond a local demo.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=password
DASHBOARD_SECRET_KEY=dev-insecure-secret-change-me
# Google sign-in (optional). Create an OAuth 2.0 Client (Web) in Google Cloud Console,
# add redirect URIs http://localhost:8050/auth/callback and
# http://127.0.0.1:8050/auth/callback, then paste the values here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of allowed Google emails. Empty = any authenticated account.
GOOGLE_ALLOWED_EMAILS=
